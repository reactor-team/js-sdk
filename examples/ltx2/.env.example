# ── Required ─────────────────────────────────────────────────────────────────

# Server-side Reactor API key, used by /api/reactor/token to mint short-lived
# session JWTs. The key itself never reaches the browser.
#
# Get one from https://www.reactor.inc/account/api-keys.
#
# NOTE: ltx2 is not listed publicly yet, so a key works only once its account
# has been granted access to the model. Ask the Reactor team.
REACTOR_API_KEY=rk_your_api_key_here

# ── Optional ─────────────────────────────────────────────────────────────────

# The Reactor API the app talks to. Both the browser-side provider and the
# server-side token mint read this single value, because a JWT minted against
# one environment is not valid on another.
#
# Defaults to production, which is where ltx2 runs. Only set this if you were
# pointed at a different environment.
# NEXT_PUBLIC_REACTOR_API_URL=https://api.reactor.inc
