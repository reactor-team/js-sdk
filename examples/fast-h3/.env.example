# Required. The server mints short-lived, session-scoped JWTs from this;
# the browser never sees the raw key. rk_... from
# https://www.reactor.inc/account/api-keys
REACTOR_API_KEY=

# Optional: bring your own OpenAI-compatible key and the episode composer
# gains a "Write scenes with AI" button (served by /api/upsample). Without
# it, you write each scene by hand — the composer guides you.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
