# The same LiveKit project the streamer publishes into. The server mints
# subscribe-plus-chat tokens from these; the secret never reaches the
# browser.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Must match the streamer's LIVEKIT_ROOM.
LIVEKIT_ROOM=fast-h3-livestream
