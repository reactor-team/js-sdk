# ---------------------------------------------------------------- Reactor ---
# The API key the streamer connects to the model with (rk_... from
# https://www.reactor.inc/account/api-keys). The streamer keeps trying to
# connect in a loop; while the model is at capacity or unreachable, the
# broadcast holds the last frame and reconnects in the background.
REACTOR_API_KEY=
# The model to drive. reactor/fast-h3 supports scene chaining
# (continue_from_clip_id), which the streamer uses to play an episode as one
# uninterrupted video.
REACTOR_MODEL=reactor/fast-h3

# ---------------------------------------------------------------- LiveKit ---
# The room the show is broadcast into. The streamer creates the room, is its
# only media publisher, and reads viewer ideas from the room's chat topic.
# The viewer app must point at the same LiveKit project and room name.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM=fast-h3-livestream

# -------------------------------------------------------- Episode writing ---
# Bring your own OpenAI-compatible key to expand chat ideas into multi-scene
# episodes. Optional: with no key, every idea becomes a single scene of its
# raw text and the show still runs. OPENAI_BASE_URL points the call at any
# compatible endpoint (a proxy, a local server, another provider).
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# The style block every scene is written in. The built-in default is a flat
# 2D cel-animated cartoon look matching default.json's rotation.
# SHOW_STYLE=Flat 2D cel-animated cartoon, thick black outlines, saturated colors.

# ---------------------------------------------------------- Episode shape ---
# Scenes per episode. Fixed here, never decided by the LLM: the upsampler is
# asked for exactly this many scenes per idea.
SCENES_PER_EPISODE=3
# Length of every scene in seconds. Clamped at enqueue time to the bounds
# the deployment publishes (5.167-14.375 s at today's defaults).
SCENE_SECONDS=10
# How many scenes the streamer keeps queued from default.json while no
# viewer ideas are waiting. Self-clamps under the deployment's live playout
# capacity so episodes always have room to land.
QUEUE_TARGET=4
